# Test environment used by integration tests (NODE_ENV=test).
# The database is provided by the `postgres_test` service in docker-compose.yml.
# Override any of these with real values in CI.

# --- Database (test) ---
TEST_POSTGRES_USER=postgres
TEST_POSTGRES_PASSWORD=postgres
TEST_POSTGRES_DB=eduflow_test
TEST_POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/eduflow_test

# --- API ---
BACKEND_PORT=3001

# --- JWT ---
JWT_ACCESS_SECRET=test-access-secret
JWT_REFRESH_SECRET=test-refresh-secret
JWT_RESET_SECRET=test-reset-secret
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=test-cookie-secret

# --- Google OAuth (empty in tests) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (empty in tests) ---
EMAIL_USER=
EMAIL_PASSWORD=

FRONTEND_URL=http://localhost:5173
