# Copy to .env and fill in real values:  cp .env.example .env
# Docker Compose also reads this file for ${...} substitution, so
# POSTGRES_* below control the database container credentials.

# --- Database (docker compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=eduflow
POSTGRES_PORT=5432

# Used when running the API outside Docker (npm run start:dev).
# Inside Docker this is overridden by docker-compose.yml to point at the
# `postgres` service, so keep it on localhost here.
DATABASE_URL=postgresql://postgres:change-me-in-production@localhost:5432/eduflow

# --- API ---
BACKEND_PORT=3000

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-long-random-string
JWT_REFRESH_SECRET=replace-with-long-random-string
JWT_RESET_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
COOKIE_SECRET=replace-with-long-random-string

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (password reset) ---
EMAIL_USER=
EMAIL_PASSWORD=

# Must match the URL the frontend is served from (browser origin for CORS).
FRONTEND_URL=http://localhost:5173